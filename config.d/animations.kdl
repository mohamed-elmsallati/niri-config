animations {
    // off

    slowdown 0.25

    workspace-switch {
        // off
        spring damping-ratio=0.9 stiffness=523 epsilon=0.0001
    }

    window-open {
    }

    window-close {
    }

    horizontal-view-movement {
        spring damping-ratio=0.80 stiffness=523 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=0.8 stiffness=523 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=0.8 stiffness=523 epsilon=0.0001
    }

    config-notification-open-close {
        spring damping-ratio=0.8 stiffness=523 epsilon=0.0001
    }

    screenshot-ui-open {
        spring damping-ratio=0.8 stiffness=523 epsilon=0.0001
    }

   overview-open-close {
        spring damping-ratio=0.8 stiffness=523 epsilon=0.0001
    }
}
