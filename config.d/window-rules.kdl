window-rule {
    background-effect {
        xray false
        blur true
        noise 0.5
        saturation 3

    }

    // popups {
    //     opacity 0.99
    //     geometry-corner-radius 15
    //
    //     background-effect {
    //         xray false
    //         blur true
    //         noise 0.07
    //         saturation 1
    //     }
    // }

    border {
        // on

    }
    focus-ring{
        off
    }
    opacity 0.9

    geometry-corner-radius 0
    clip-to-geometry true
}


/-window-rule {
  match app-id="dev.noctalia.Noctalia.Settings"
  open-floating true

    border {
        off
        active-color   "#000000"
        inactive-color "#161616"
        urgent-color   "#ee5396"
    }

  default-column-width { fixed 900; }
  default-window-height { fixed 500; }
  default-floating-position x=500 y=-10 relative-to="top-left"

  shadow {
      off
  }
}

window-rule {
  // Match the custom class you just set
  match app-id="Scratchpad"

    border {
        // off
        on
        active-color   "#000000"
        inactive-color "#161616"
        urgent-color   "#ee5396"
    }

  // Example rules: make it float, center it, and set a specific size
  open-floating true
  default-column-width { proportion 0.5; }
  default-window-height { proportion 0.5; }
  default-floating-position x=500 y=-10 relative-to="top-left"

  shadow {
      off
  }

}

/-window-rule {
    match is-floating=true
    exclude app-id="dev.noctalia.Noctalia.Settings"
    exclude app-id="Scratchpad"
    default-floating-position x=500 y=500 relative-to="top-left"

    border {
        on
        active-color   "#000000"
        inactive-color "#161616"
        urgent-color   "#ee5396"
    }

    focus-ring {
        off
    }

    shadow {
        on
        // off
        softness 0
        spread 0
        offset x=10 y=10
        draw-behind-window true
        color "#000000cc"
        // inactive-color "#00000064"
    }



    min-width 480
    max-width 720
    min-height 300
    max-height 600

}

