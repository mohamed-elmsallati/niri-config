// Dim unfocused windows slightly for visual hierarchy.
// ── Per-app fixes ───────────────────────────────────────────────────────────

// WezTerm: work around initial configure bug (needs an empty default width).
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

window-rule {
    match app-id=r#"zen$"#
    opacity 1.0
    background-effect {
        xray true
        blur true
        noise 0.01
        saturation 3
    }
        popups {
        opacity 1.0
        geometry-corner-radius 15

        background-effect {
            xray false
            blur false
            noise 0.01
            saturation 1
        }
    }

}

window-rule {
    match app-id=r#"zen$"# title="^Parent process Browser Toolbox$"
    open-floating true


    min-width 1080
    max-width 1080
    min-height 500
    max-height 500

}




// Firefox / Zen / vivaldi: picture-in-picture window opens floating.
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}
window-rule {
    match app-id=r#"zen$"# title="^Picture-in-Picture$"
    default-floating-position x=10 y=10 relative-to="bottom-right"

    open-floating true

    baba-is-float true

    min-width 560
    max-width 560
    min-height 315
    max-height 315

}


window-rule {
    // vivaldi: picture-in-picture window opens floating.
    match title="^Picture in picture$"
    opacity 1.0
    default-floating-position x=10 y=10 relative-to="bottom-right"
    open-floating true
    baba-is-float true

    border {
        off
    }

    min-width 560
    max-width 560
    min-height 315
    max-height 315
}

window-rule {
    match app-id=r#"vivaldi-stable$"#

    clip-to-geometry true
    // tiled-state true
    open-maximized-to-edges false
    draw-border-with-background false

}
window-rule {
    match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="bottom-right"
}

